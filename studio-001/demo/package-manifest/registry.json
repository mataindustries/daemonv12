  "instruments": [
    {
      "id": "living-bass",
      "family": "living-bass",
      "name": "Living Bass",
      "version": "1.0.0+mutation-001-A",
      "macro": {
        "id": "warm-machine",
        "label": "warm → machine",
        "from": "warm",
        "to": "machine"
      },
      "description": "West Coast low-pass-gated complex oscillator over a phase-locked sine sub that turns, continuously and in tempo, into a folded, geared, driven machine with ratcheting servo slides and metal chassis strikes.",
      "range": [
        24,
        60
      ],
      "articulations": {
        "normal": "plucked through the low-pass gate (gate 90 %)",
        "accent": "harder strike (velocity x1.15), chassis hit at the machine end",
        "ghost": "soft (velocity x0.6), short (50 %)",
        "staccato": "short (45 %)",
        "legato": "no re-strike; travels from the previous pitch (slide, default 0.06 s)"
      },
      "controls": [
        {
          "name": "fold",
          "min": 0,
          "max": 1,
          "description": "sine-folder gain: harmonic richness"
        },
        {
          "name": "pm",
          "min": 0,
          "max": 1.5,
          "description": "1:1 phase modulation: saw-like edge"
        },
        {
          "name": "grind",
          "min": 0,
          "max": 1.15,
          "description": "1:2 phase modulation: sub-octave grind"
        },
        {
          "name": "gear",
          "min": 0,
          "max": 0.7,
          "description": "phase-locked sub-octave chopper depth"
        },
        {
          "name": "drive",
          "min": 0,
          "max": 1,
          "description": "asymmetric tube drive"
        },
        {
          "name": "bright",
          "min": 0,
          "max": 1,
          "description": "low-pass-gate opening range"
        },
        {
          "name": "hold",
          "min": 0,
          "max": 0.84,
          "description": "gate opening while a note is held"
        },
        {
          "name": "chassis",
          "min": 0,
          "max": 1,
          "description": "metal chassis strikes and ratchet clicks"
        },
        {
          "name": "ratchet",
          "min": 0,
          "max": 1,
          "description": "slides step through semitones"
        },
        {
          "name": "servo",
          "min": 0,
          "max": 1,
          "description": "0 damped finger slide .. 1 overshooting servo"
        },
        {
          "name": "motion",
          "min": 0,
          "max": 1,
          "description": "depth of the tempo-synced modulation"
        },
        {
          "name": "harm",
          "min": 0,
          "max": 1,
          "description": "octave/fifth harmonic selector"
        },
        {
          "name": "body",
          "min": 0,
          "max": 1,
          "description": "harmonic body over the constant sub"
        }
      ],
      "setup": [
        {
          "name": "seed",
          "min": 0,
          "max": 4294967295,
          "description": "random seed for drift and chassis noise"
        }
      ],
      "params": {
        "scoop": "semitones to rise from on a fresh strike",
        "dive": "semitones to dive at the end of the note",
        "diveBeats": "length of the dive in beats"
      },
      "suggestedGainDb": -3
    },
    {
      "id": "impossible-voice",
      "family": "impossible-voice",
      "name": "Impossible Voice",
      "version": "1.0.0+mutation-001-B",
      "macro": {
        "id": "human-impossible",
        "label": "human → impossible",
        "from": "human",
        "to": "impossible"
      },
      "description": "Additive source-filter voice (no words, no language, no real singer): vowels drift, breath and cries, then bent harmonic series, split formants, undertones, an overtone melody, spectral shimmer and a sympathetic glass halo tuned to the key.",
      "range": [
        43,
        84
      ],
      "articulations": {
        "sung": "fresh onset with a small scoop",
        "legato": "glides from the previous note (slide in beats, default about 0.06 s)",
        "detached": "shorter (80 %)",
        "cry": "upward voice-break flip at the onset (param cry, semitones, default 1)",
        "fall": "sighing fall at the end (param fall, semitones, default 0.8)",
        "hum": "closed-mouth \"mm\" unless a vowel is given"
      },
      "controls": [
        {
          "name": "breath",
          "min": 0,
          "max": 1,
          "description": "pitch-synchronous aspiration"
        },
        {
          "name": "tilt",
          "min": 0,
          "max": 1,
          "description": "source tilt: soft .. bright"
        },
        {
          "name": "size",
          "min": -1,
          "max": 1,
          "description": "tract scale (formants)"
        },
        {
          "name": "split",
          "min": 0,
          "max": 0.3,
          "description": "each formant divides into two peaks"
        },
        {
          "name": "stretch",
          "min": 0,
          "max": 0.05,
          "description": "harmonic n at n^(1+stretch): the series bends into a bell"
        },
        {
          "name": "under",
          "min": 0,
          "max": 1,
          "description": "undertone series under the voice"
        },
        {
          "name": "whistle",
          "min": 0,
          "max": 1,
          "description": "overtone-singing melody (overtone lane)"
        },
        {
          "name": "glass",
          "min": 0,
          "max": 1,
          "description": "send to the sympathetic glass halo"
        },
        {
          "name": "shimmer",
          "min": 0,
          "max": 1,
          "description": "vibrato migrates into the spectrum"
        },
        {
          "name": "even",
          "min": 0,
          "max": 1,
          "description": "even harmonics (1 = normal, 0 = hollow)"
        },
        {
          "name": "disperse",
          "min": 0,
          "max": 1,
          "description": "harmonics drift apart, high ones linger"
        },
        {
          "name": "vib",
          "min": 0,
          "max": 1.5,
          "description": "vibrato depth scale"
        }
      ],
      "setup": [
        {
          "name": "size",
          "min": -1,
          "max": 1,
          "description": "fixed tract scale (giant .. small)"
        },
        {
          "name": "detune",
          "min": -50,
          "max": 50,
          "description": "cents"
        },
        {
          "name": "vibRate",
          "min": 3,
          "max": 8,
          "description": "Hz"
        },
        {
          "name": "vibCents",
          "min": 0,
          "max": 60,
          "description": "vibrato depth"
        },
        {
          "name": "vowelTau",
          "min": 0.03,
          "max": 0.6,
          "description": "vowel glide time constant (s)"
        },
        {
          "name": "seed",
          "min": 0,
          "max": 4294967295,
          "description": "random seed"
        },
        {
          "name": "haloDecay",
          "min": 0.2,
          "max": 3,
          "description": "glass resonator decay (s)"
        },
        {
          "name": "haloGain",
          "min": 0,
          "max": 3,
          "description": "halo level scale"
        }
