  "node": "v22.23.4",
  "title": "CROSSING",
  "bpm": 84,
  "key": "C minor",
  "transpose": 0,
  "frames": 2373841,
  "sections": [
    {
      "id": "alien-night",
      "bars": 4,
      "development": "alien machinery and the impossible voice: gong bars, laser springs, a bowed drone with a twelfth-below subharmonic, bearings, zipping clock; the theme as a fragment",
      "startBeat": 0
    },
    {
      "id": "arrival",
      "bars": 4,
      "development": "the Living Bass enters warm with a West Coast groove; tines and clock wake; the voice sings the whole theme, still strange",
      "startBeat": 16
    },
    {
      "id": "crossing",
      "bars": 4,
      "development": "voice and orchestra fall toward human and clockwork while the bass rises toward the machine; at bar 11 every macro is near 0.5 and voice and bars sing the theme in unison",
      "startBeat": 32
    },
    {
      "id": "exchange",
      "bars": 4,
      "development": "roles exchanged: a human voice and a clockwork music box over a growling machine bass with triplet and thirty-second gear motion",
      "startBeat": 48
    },
    {
      "id": "coda",
      "bars": 2,
      "development": "the machine bass relaxes back to warm inside one held low C; the human hum ends on C and the glass halo returns as an echo",
      "startBeat": 64
    }
  ],
