{
  "schema": "daemonv12.signature-rack.score/1",
  "title": "Two Names for One Fire · side A",
  "bpm": 96,
  "key": "G minor",
  "timeSignature": "4/4",
  "swing": 0.5,
  "seed": 52,
  "tailSeconds": 2,
  "masterGainDb": 0,
  "description": "A storyteller at a fire and the creature in the story are the same animal: the tale is whispered on a reed over hands and clay, and when the drum calls it by its other name it comes out of the dark at one and a half times the speed.",
  "sections": [
    {
      "id": "embers",
      "bars": 2,
      "development": "the tale, whispered once; one clay pot answers"
    },
    {
      "id": "circle",
      "bars": 4,
      "development": "hands join in twelve; the reed finds its voice"
    },
    {
      "id": "telling",
      "bars": 4,
      "development": "same tale, more breath: the reed warms bar by bar"
    },
    {
      "id": "door",
      "bars": 2,
      "development": "the teller stops, something hums in the dark; then the drum rolls alone in the pulse of what is coming"
    }
  ],
  "room": {
