  "seed": 3903,
  "tailSeconds": 6,
  "masterGainDb": 0,
  "description": "One 10-second cyclic miniature: a glass double call becomes a vowel; a diminished-seventh orbit breaks open into an intimate A-flat major revelation. No borrowed melody or recorded voice. TailSeconds is the source bounce allowance; delivery folds its decay into exactly four bars.",
  "sections": [
    {
      "id": "threshold",
      "bars": 1,
      "development": "A double glass call and a voice that seems to open inside it."
    },
    {
      "id": "turn",
      "bars": 1,
      "development": "The call climbs a minor third while a distant voice descends."
    },
    {
      "id": "unoccupied",
      "bars": 1,
      "development": "An empty landing; the expected diminished harmony opens into A-flat major and one close voice."
    },
    {
      "id": "recognition",
      "bars": 1,
      "development": "The transformed call reaches B; C-sharp asks for D across the loop seam."
    }
  ],
