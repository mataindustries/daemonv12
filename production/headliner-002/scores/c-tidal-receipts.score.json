  "schema": "daemonv12.signature-rack.score/1",
  "title": "THE MOON KEEPS RECEIPTS — Sketch C (Beyond the Known)",
  "bpm": 116,
  "key": "E major",
  "timeSignature": "4/4",
  "swing": 0.5,
  "seed": 303,
  "tailSeconds": 2,
  "masterGainDb": 0,
  "description": "Original experimental sketch: a 5-note Lydian gravity motif in 7-beat cells crossing 4/4 barlines, hocketed between spring and bars; bass pulses in the same 7-cycle; a voice only later sings the motif whole; a subharmonic zero-gravity break; finale gives the motif to the overtone lane over a held root.",
  "sections": [
    {
      "id": "signal",
      "bars": 7,
      "development": "motif transmitted in four 7-beat cells crossing the barlines, hocketed spring (low octave)/bars, bearings rain, no voice, no bass (beats 0-28)"
    },
    {
      "id": "gravity-hook",
      "bars": 7,
      "development": "bass pulses every 7 beats (E-C#-A-B) against the barlines while the voice finally sings the motif whole twice (beats 28-56)"
    },
    {
      "id": "zero-gravity",
      "bars": 2,
      "development": "everything drops: bowed octave-subharmonic drone and one lone A# ring (beats 56-64)"
    },
    {
      "id": "return",
      "bars": 2,
      "development": "motif returns reordered and harder in bars; voice holds only the root while its overtone lane plays the motif; final bass dive (beats 64-72)"
    }
  ],
