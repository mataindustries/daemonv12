  "schema": "daemonv12.signature-rack.score/1",
  "title": "HOOK//10 B2 (motif development: signal call, fast mallet response, major reveal)",
  "bpm": 96,
  "key": "D minor",
  "timeSignature": "4/4",
  "seed": 10,
  "tailSeconds": 10,
  "masterGainDb": 0,
  "description": "HOOK//10, condition B (score/2), second approach. A repeated-note signal in the voice and bass; the mallets answer every call at double speed. Dm | Bb C | D major (the reveal) | Gm A7, then the A7 resolves across the loop point.",
  "sections": [
    {
      "id": "signal",
      "bars": 1,
      "development": "the signal: three repeated notes, a leap to the tonic, a reach up to the ninth; voice and bass in rhythmic unison; the mallets answer twice as fast"
    },
    {
      "id": "lift",
      "bars": 1,
      "development": "the same call a third lower while the bass climbs B-flat to C under it"
    },
    {
      "id": "reveal",
      "bars": 1,
      "development": "the signal in D major, ending on the major third; the clock drops to half time and its ticks sprout springs"
    },
    {
      "id": "turn",
      "bars": 1,
      "development": "the signal upside down over G minor and A7; the mallets answer upside down too and both land on A"
    }
  ],
  "room": {
    "rt60": 1.9,
    "size": 1.1,
    "damp": 5600,
    "predelayMs": 20,
