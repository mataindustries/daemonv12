{
  "title": "HOOK//10 B1 (motif development: statement, answer, climb, inversion)",
  "bpm": 96,
  "beatSeconds": 0.625,
  "key": "D minor",
  "transpose": 0,
  "swing": 0.5,
  "seed": 10,
  "sections": [
    {
      "id": "call",
      "bars": 2,
      "development": "the hook over D minor, then the same hook a third lower over B-flat: the answer",
      "startBeat": 0
    },
    {
      "id": "climb",
      "bars": 1,
      "development": "the hook's rising-sixth head alone, climbing by step; mallets play it twice as fast against the voice; the clock runs double time; the bass changes chord every two beats",
      "startBeat": 8
    },
    {
      "id": "turn",
      "bars": 1,
      "development": "the hook upside down as the cadence: the cry becomes a falling sigh; A7 with a flat ninth, resolved by the first bar of the next pass",
      "startBeat": 12
    }
  ],
