  "masterGainDb": 0,
  "description": "HOOK//10, condition B (score/2), third approach. The B1 hook, answered by its mirror image, then sung at half speed across two bars while the mallets keep playing it at full speed. Dm | F | Bb | C A7, then the A7 resolves across the loop point.",
  "sections": [
    {
      "id": "call",
      "bars": 1,
      "development": "the hook over D minor"
    },
    {
      "id": "mirror",
      "bars": 1,
      "development": "the hook upside down over F major: it starts on the high note, falls the sixth and climbs back"
    },
    {
      "id": "broad",
      "bars": 2,
      "development": "the hook at half speed in the voice, with an upper-neighbour melisma on its long note; the mallets play it at full speed underneath, once per bar; the clock drops to half time"
    }
  ],
