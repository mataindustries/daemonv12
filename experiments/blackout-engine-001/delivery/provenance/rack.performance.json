{
  "title": "BLACKOUT//ENGINE",
  "bpm": 128,
  "beatSeconds": 0.46875,
  "key": "G minor",
  "transpose": 0,
  "swing": 0.5,
  "seed": 1280,
  "sections": [
    {
      "id": "ignition",
      "bars": 2,
      "development": "The riff at once, already a machine: three G strokes, the octave scream, the ratchet stair. Kick, snare, bass only.",
      "startBeat": 0
    },
    {
      "id": "engine-room",
      "bars": 4,
      "development": "The engine room joins: clock escapement, anvil taps, wood knocks, a spring recoil after each hammer. The bass heats up.",
      "startBeat": 8
    },
    {
      "id": "brownout",
      "bars": 2,
      "development": "Bar 7 misfires (a stroke and the hammer missing, a spring snaps instead). Bar 8 the strokes weaken; on beat 3 the breaker trips.",
      "startBeat": 24
    },
    {
      "id": "dark",
      "bars": 2,
      "development": "Silence and a ringing room. A breath. One human voice sings the stair slowly. Hot metal ticks as it cools.",
      "startBeat": 32
    },
    {
      "id": "cold-start",
      "bars": 2,
      "development": "The engine coughs warm in the riff rhythm, chopping the held note; stroke by stroke it heats up and the stair returns in unison.",
      "startBeat": 40
    },
    {
      "id": "in-the-gears",
      "bars": 4,
      "development": "Full machine, the voice gated into the riff and pushed toward impossible, never allowed the D. Second blackout on the scream; the voice sighs Eb-D alone.",
      "startBeat": 48
    }
  ],
