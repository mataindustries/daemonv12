 "title": "Concrete Gospel Full-Length: CATHEDRAL//ENGINE great",
 "bpm": 144,
 "key": "F minor",
 "swing": 0.5,
 "seed": 4002,
 "tailSeconds": 5,
 "masterGainDb": 0,
 "description": "CATHEDRAL//ENGINE great with its Nave.",
 "sections": [
  {
   "id": "intro",
   "bars": 8,
   "development": "The preacher alone: the lead's call, the organ's answer, the lead's answer, the choir's hum; Fm, Db, then C7 and a breath."
  },
  {
   "id": "hook",
   "bars": 8,
   "development": "The drop on V2's own pocket: the V3 hook as a four-bar question and answer, the climb, the peak, V2's hole."
  },
  {
   "id": "verse-1",
   "bars": 16,
   "development": "Room for a voice: a new 808 line (Fm Fm Db C); the lead only tags the end of each four-bar line; a hum enters halfway."
  },
  {
   "id": "chorus-1",
   "bars": 8,
   "development": "The second hook: the lead calls F-Ab-C, a few singers answer Eb-Db-C, the organ echoes; Db Eb Fm C."
  },
  {
   "id": "verse-2",
   "bars": 12,
   "development": "More pressure (stutter kicks, sixteenth hats, octave hops); then a half-time floor and one stop-time on the second hook."
  },
  {
   "id": "bridge",
   "bars": 8,
   "development": "No drums, no 808: the choir alone (Bbm9, the Neapolitan Gb, C7b9), then the organ and Pedal and the lead's cry."
  },
  {
   "id": "chorus-2",
   "bars": 8,
   "development": "The ceiling opens: the lead calls with the first hook, the full choir answers with the second, full-organ hits."
  },
  {
   "id": "outro",
   "bars": 8,
   "development": "V2's amen groove and dive; Db, C7, then F major; the lead bends its Ab up to A."
  }
 ],
