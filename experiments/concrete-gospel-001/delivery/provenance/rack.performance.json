    {
      "id": "sermon",
      "bars": 4,
      "development": "Hook alone on the reed, heard through concrete (band-limited); choir oo on Fm/Bbm; bell toll.",
      "startBeat": 0
    },
    {
      "id": "doors",
      "bars": 4,
      "development": "The wall opens on bar 5: full-band reed, kick + 808 + snare/clap + hats + steel clank (groove A twice).",
      "startBeat": 16
    },
    {
      "id": "crack",
      "bars": 4,
      "development": "Groove B pushes; the moan falls deeper; bar 12 the floor tape-stops away and the congregation answers in major.",
      "startBeat": 32
    },
    {
      "id": "amen",
      "bars": 4,
      "development": "Slam back to F minor, reed and 808 hotter; final answer, 808 dive, minor amen, bell.",
      "startBeat": 48
    }
