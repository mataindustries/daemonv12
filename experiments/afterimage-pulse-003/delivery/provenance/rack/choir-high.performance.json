{
  "title": "AFTERIMAGE//PULSE (full length): HEAVEN//MASS high",
  "bpm": 136,
  "beatSeconds": 0.441176,
  "key": "E major",
  "transpose": 0,
  "swing": 0.5,
  "seed": 3366,
  "sections": [
    {
      "id": "image",
      "bars": 4,
      "development": "V2: the hook dark and close; the music box behind it; kick and bass from bar 3.",
      "startBeat": 0
    },
    {
      "id": "pulse",
      "bars": 8,
      "development": "V2: 2-step; the bass answers each held note, then pulls in dotted eighths and realigns.",
      "startBeat": 16
    },
    {
      "id": "undertow",
      "bars": 14,
      "development": "C#m A F#m G#7: the bass leads with the reply; the synth answers with single pulse pairs; the voice takes two notes of each riff; breakdown and a stop on the pulse.",
      "startBeat": 48
    },
    {
      "id": "dark-union",
      "bars": 8,
      "development": "The hook over the reply in C# minor.",
      "startBeat": 104
    },
    {
      "id": "glitch",
      "bars": 5,
      "development": "One melody passed between voice, bass, talking drum and log; convergence; silence; the cry.",
      "startBeat": 136
    },
    {
      "id": "afterimage",
      "bars": 4,
      "development": "V2 note for note: the hook at half speed in the choir; the sink into C major; the bloom.",
      "startBeat": 156
    },
    {
      "id": "hymn",
      "bars": 10,
      "development": "C turns to E; the reply as a hymn in canon (altos, sopranos, music box); the glitch chords become the cadence.",
      "startBeat": 172
    },
    {
      "id": "return",
      "bars": 10,
      "development": "The heartbeat quickens into the groove; the reply as an E major bass riff; the synth answers.",
      "startBeat": 212
    },
    {
      "id": "finale",
      "bars": 19,
      "development": "Hook over reply; the swap; the choir catches up through the cascade; the deceptive landing on C; C D E; the last groove; the bass break; the first pulse pair.",
      "startBeat": 252
    },
    {
      "id": "ending",
      "bars": 4,
      "development": "The music box alone: the opening image, the reply, the resolving pair.",
      "startBeat": 328
    }
  ],
