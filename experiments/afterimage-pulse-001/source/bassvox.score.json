{
 "schema": "daemonv12.signature-rack.score/1",
 "title": "AFTERIMAGE//PULSE: Living Bass and Impossible Voice",
 "description": "The talking bass and the glitch-section voice.",
 "bpm": 136,
 "key": "E major",
 "swing": 0.5,
 "seed": 1363,
 "tailSeconds": 2,
 "masterGainDb": 0,
 "sections": [
  {
   "id": "image",
   "bars": 4,
   "development": "The hook alone on an analog pluck with the music-box afterimage behind it; light rims and hats; kick and bass join in bar 3; a hand-drum fill in the hook rhythm."
  },
  {
   "id": "pulse",
   "bars": 8,
   "development": "2-step groove. THRONE//VOLT sings the hook, swooping into each held note; Living Bass talks in the holes. The second statement adds the full canon and open hats."
  },
  {
   "id": "glitch",
   "bars": 4,
   "development": "E minor: Am, B7, Cmaj7#11, D7. Impossible Voice chops the hook with impossible vowels; the bass answers with ratchet dives; half-time broken beat; the pulse quickens and the band falls away."
  },
  {
   "id": "afterimage",
   "bars": 4,
   "development": "No drums, a hand-drum heartbeat. The choir sings the hook at half speed (F#m9, Amaj9, C#m7) while the music box remembers it at tempo; the harmony sinks into C major and the choir blooms."
  },
  {
   "id": "payoff",
   "bars": 6,
   "development": "C to A: everything lifts a semitone. Lead an octave up at blaze, the choir on the long notes, bass and kick locked to the pulse pairs; the answer resolves to E. The band stops on the next first pair and the music box finishes alone."
  }
 ],
