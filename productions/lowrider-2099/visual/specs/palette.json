{
  "name": "ANGELES//2099 palette",
  "rule": "Every colour in the scene comes from here. Linear values are derived in the generator from these sRGB hex codes.",
  "candyBurgundy": {
    "hex": "#5A0F1F",
    "role": "hero body base coat"
  },
  "candyBurgundyFlash": {
    "hex": "#A3203C",
    "role": "body flake/flash where the clear coat catches light"
  },
  "chrome": {
    "hex": "#E4E2EA",
    "role": "bumpers, trim, wheels, struts (slight violet bias)"
  },
  "warmGold": {
    "hex": "#E2A84B",
    "role": "trim inlays, hover ring cores, crown lights"
  },
  "sodiumGrid": {
    "hex": "#FFB35A",
    "role": "the LA street grid at night"
  },
  "violetHaze": {
    "hex": "#6B4AA8",
    "role": "atmosphere, distance haze after sunset"
  },
  "hoverViolet": {
    "hex": "#9C6BFF",
    "role": "hover field emission, underglow"
  },
  "sunsetHorizon": {
    "hex": "#FF8A4C",
    "role": "horizon band at golden hour"
  },
  "skyNight": {
    "hex": "#1B1532",
    "role": "zenith after the sun is down"
  },
  "granite": {
    "hex": "#8A7A6A",
    "role": "San Gabriel granite, lit"
  },
  "graniteShadow": {
    "hex": "#2E2630",
    "role": "rock in shadow (violet-biased, never grey)"
  },
  "asphalt": {
    "hex": "#26252B",
    "role": "road surface"
  },
  "laneYellow": {
    "hex": "#E8C35A",
    "role": "double yellow centre line"
  },
  "laneWhite": {
    "hex": "#D9D6DC",
    "role": "edge lines"
  },
  "towerGlass": {
    "hex": "#2B2740",
    "role": "megatower glass by day"
  },
  "windowWarm": {
    "hex": "#FFD08A",
    "role": "lit windows"
  },
  "windowCool": {
    "hex": "#B9A8FF",
    "role": "lit windows, residential towers (1 in 4)"
  }
}
